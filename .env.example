# Copy to `.env.development.local` to override machine-specific values (gitignored via `*.local`).

# JSON API host (no trailing slash). Axios uses: `{origin}/api/{VITE_API_VERSION}`
VITE_API_ORIGIN=http://localhost:3001
VITE_API_VERSION=v1

# Optional: full base URL — wins over origin + version when set
# VITE_API_BASE_URL=http://localhost:3001/api/v1

# Optional: origin for `/api/files/...` PDF URLs when UI runs on another host/port
# VITE_PUBLIC_ORIGIN=http://localhost:3001

# Optional: dev proxy target for `/api` when using relative API URLs (defaults to VITE_API_ORIGIN or http://localhost:3001)
# VITE_DEV_API_PROXY=http://localhost:3001
